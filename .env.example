# Database — Supabase PostgreSQL connection string
DATABASE_URL=

# Auth.js v5
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth — https://developer.apple.com/account/resources/identifiers
# Set all three to enable Apple sign-in (provider + UI button)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
NEXT_PUBLIC_APPLE_ENABLED=

# Tesla OAuth (account linking) — https://developer.tesla.com
# Set both to enable Tesla account linking on the Settings page
AUTH_TESLA_ID=
AUTH_TESLA_SECRET=

# Real-time telemetry — WebSocket URL of the Go telemetry server
# The useVehicleStream hook appends /api/ws to this URL
# Local dev: ws://localhost:8080  |  Production: wss://telemetry.myrobotaxi.app
NEXT_PUBLIC_WS_URL=

# Telemetry server REST API — used server-side for fleet config push
# Local dev: http://localhost:8080  |  Production: https://telemetry.myrobotaxi.app
TELEMETRY_API_URL=

# Mapbox GL JS — https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Beta access gate — set to require a password before sign-in (remove to disable)
BETA_ACCESS_PASSWORD=

# Status page prober (MYR-510) — the Vercel Cron job at /api/cron/status.
#
# CRON_SECRET is Vercel's documented pattern: the scheduler sends it as
# `Authorization: Bearer <value>` on every run, and the handler refuses
# everything else. Generate with `openssl rand -hex 32` and set it in the Vercel
# project settings. Unset means the endpoint refuses every caller — including
# the scheduler — and the page reports "No data" within ten minutes, which is
# the correct thing for it to say.
CRON_SECRET=

# What the prober points at. Both default to production, so an unset variable
# probes the real thing rather than nothing. Override on a preview deployment.
#
# Port 4443 on purpose: 443 on the same host is a mutual-TLS listener for
# vehicles and would report a permanent, imaginary outage.
STATUS_TELEMETRY_ORIGIN=
STATUS_SITE_ORIGIN=

# Sentry — https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Column-level encryption (MYR-62) — AES-256-GCM key for OAuth token columns.
# Match the value used by the Go telemetry service so rows encrypted by either
# side are decryptable by the other. See lib/cryptox for the wire format.
#
# Single-key shorthand (v1 deployments before any rotation):
#   ENCRYPTION_KEY=<base64(32B)>
#
# Versioned shape (during/after a rotation):
#   ENCRYPTION_KEY_V1=<base64(32B)>
#   ENCRYPTION_KEY_V2=<base64(32B)>
#   ENCRYPTION_WRITE_VERSION=2
#
# Generate a new key with: openssl rand -base64 32
ENCRYPTION_KEY=

# Retired-app lockdown (see src/lib/lockdown.ts) — every route except the
# public invite pages, /.well-known, /api/auth and static assets redirects to
# /join. ON by default; set to exactly "1" to switch it off. Production sets
# nothing. The Playwright suite sets it so it can still cover the retired app.
LOCKDOWN_DISABLED=
