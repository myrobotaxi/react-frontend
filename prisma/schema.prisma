generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  vehicles      Vehicle[]
  invitesSent   Invite[]  @relation("InviteSender")
  settings      Settings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  // ─── Encrypted shadows (MYR-62 Phase 1) ─────────────────────────────────
  // AES-256-GCM ciphertext (base64) for each OAuth token. Written
  // alongside the plaintext columns during the dual-write rollout; a
  // follow-up issue backfills, flips reads to enc-only, then drops the
  // plaintext columns. Wire format owned by lib/cryptox (TS) and
  // internal/cryptox (Go) — see docs/contracts/data-classification.md.
  access_token_enc  String? @db.Text
  refresh_token_enc String? @db.Text
  id_token_enc      String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── Vehicles ────────────────────────────────────────────────────────────────

model Vehicle {
  id                    String        @id @default(cuid())
  userId                String
  teslaVehicleId        String?       @unique
  vin                   String?       @unique
  name                  String
  model                 String
  year                  Int
  color                 String
  licensePlate          String
  chargeLevel           Int           @default(0)
  estimatedRange        Int           @default(0)
  chargeState           String?
  timeToFull            Float?
  status                VehicleStatus @default(offline)
  speed                 Int           @default(0)
  gearPosition          String?
  heading               Int           @default(0)
  locationName          String        @default("")
  locationAddress       String        @default("")
  latitude              Float         @default(0)
  longitude             Float         @default(0)
  // MYR-63 Phase 1 — encrypted shadow columns (P1 per data-classification.md §1.3,
  // NFR-3.23). Dual-write window: writes go to BOTH plaintext Float and *Enc TEXT;
  // reads prefer *Enc with plaintext fallback. See src/lib/vehicle-gps-encryption.ts.
  latitudeEnc             String?
  longitudeEnc            String?
  interiorTemp          Int           @default(0)
  exteriorTemp          Int           @default(0)
  odometerMiles         Int           @default(0)
  fsdMilesSinceReset    Float         @default(0)
  virtualKeyPaired      Boolean       @default(false)
  setupStatus           SetupStatus   @default(pending_pairing)
  destinationName       String?
  destinationAddress    String?
  destinationLatitude   Float?
  destinationLongitude  Float?
  destinationLatitudeEnc  String?
  destinationLongitudeEnc String?
  originLatitude        Float?
  originLongitude       Float?
  originLatitudeEnc       String?
  originLongitudeEnc      String?
  etaMinutes            Int?
  tripDistanceMiles     Float?
  tripDistanceRemaining Float?
  navRouteCoordinates   Json?
  // MYR-64 Phase 1 — encrypted shadow column for the live nav-route
  // polyline (P1 per data-classification.md §1.4). Dual-write window:
  // writes go to BOTH Json plaintext AND TEXT ciphertext; reads prefer
  // *Enc with JSON.stringify/parse at the crypto boundary, plaintext
  // fallback. See src/lib/route-blob-encryption.ts.
  navRouteCoordinatesEnc String?
  lastUpdated           DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  drives                Drive[]
  stops                 TripStop[]
  invites               Invite[]

  @@index([userId])
}

enum VehicleStatus {
  driving
  parked
  charging
  offline
  in_service
}

enum SetupStatus {
  pending_pairing
  pairing_detected
  config_pushed
  waiting_connection
  connected
}

model TripStop {
  id        String   @id @default(cuid())
  vehicleId String
  name      String
  address   String
  type      StopType
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

enum StopType {
  charging
  waypoint
}

// ─── Drives ──────────────────────────────────────────────────────────────────

model Drive {
  id               String   @id @default(cuid())
  vehicleId        String
  date             String
  startTime        String
  endTime          String
  startLocation    String
  startAddress     String
  endLocation      String
  endAddress       String
  distanceMiles    Float
  durationMinutes  Int
  avgSpeedMph      Float
  maxSpeedMph      Float
  energyUsedKwh    Float
  startChargeLevel Int
  endChargeLevel   Int
  fsdMiles         Float
  fsdPercentage    Float
  interventions    Int
  routePoints      Json
  // MYR-64 Phase 1 — encrypted shadow column for the recorded drive
  // route polyline (P1 per data-classification.md §1.4). Dual-write
  // window: writes go to BOTH Json plaintext AND TEXT ciphertext; reads
  // prefer *Enc with JSON.stringify/parse at the crypto boundary,
  // plaintext fallback. See src/lib/route-blob-encryption.ts.
  routePointsEnc   String?
  createdAt        DateTime @default(now())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, date])
}

// ─── Invites ─────────────────────────────────────────────────────────────────

model Invite {
  id           String           @id @default(cuid())
  vehicleId    String
  senderId     String
  label        String
  email        String
  status       InviteStatus     @default(pending)
  permission   InvitePermission @default(live)
  sentDate     DateTime         @default(now())
  acceptedDate DateTime?
  lastSeen     DateTime?
  isOnline     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sender       User             @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, email])
  @@index([senderId])
  @@index([vehicleId])
}

enum InviteStatus {
  pending
  accepted
}

enum InvitePermission {
  live
  live_history
}

// ─── Audit Log ───────────────────────────────────────────────────────────────
//
// Append-only audit trail for FR-10.2 / NFR-3.29. Schema mirrors
// docs/contracts/data-lifecycle.md §4.1 in the telemetry repo exactly.
//
// Notable design decisions:
//   - `userId` is intentionally NOT a relation/foreign key to User. After
//     FR-10.1 cascade deletion, the audit row must outlive the User row that
//     triggered the deletion. See data-lifecycle.md §4.5.
//   - Append-only enforcement lives at the database level via two triggers
//     (BEFORE UPDATE, BEFORE DELETE) that raise an exception. The triggers
//     are defined in the migration's raw SQL block (Prisma cannot model them).
//     See data-lifecycle.md §4.3.
//   - The Go telemetry server holds Insert-only access via raw pgx for
//     system-initiated rows (drives_pruned, mask_applied, tokens_refreshed).
//     The Next.js app writes user-initiated rows via Prisma `auditLog.create`.

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  timestamp  DateTime @default(now())
  action     String
  targetType String
  targetId   String
  initiator  String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Settings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  teslaLinked             Boolean   @default(false)
  teslaVehicleName        String?
  virtualKeyPaired        Boolean   @default(false)
  keyPairingDeferredAt    DateTime?
  keyPairingReminderCount Int       @default(0)
  notifyDriveStarted      Boolean   @default(true)
  notifyDriveCompleted    Boolean   @default(true)
  notifyChargingComplete  Boolean   @default(true)
  notifyViewerJoined      Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Service status (MYR-510) ────────────────────────────────────────────────
//
// The two tables behind https://myrobotaxi.app/status. They are deliberately
// unrelated to every model above: nothing here references a User, and the page
// that reads them is public. A status page has to be able to answer at the
// moment the rest of the product cannot.
//
// Column names are snake_case (`@map`) because the 90-day roll-up is one raw
// SQL query — see `features/status/api/status-queries.ts`. Timestamps are
// `timestamptz` so "which UTC day did this check land in" is a property of the
// value rather than of whoever is asking.

/// One probe of one component at one moment. Written only by the Vercel cron
/// handler at /api/cron/status, which also prunes rows older than 90 days.
model StatusCheck {
  id        Int      @id @default(autoincrement())
  /// Component id from `lib/status/components.ts` — e.g. 'telemetry-api'.
  component String
  /// Whether the component answered as expected. One row per component per run.
  ok        Boolean
  latencyMs Int?     @map("latency_ms")
  /// Short human-readable evidence: what answered, or what did not.
  detail    String?  @db.Text
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  @@index([component, checkedAt])
  @@index([checkedAt])
  @@map("status_checks")
}

/// A written incident record. Authored by hand (a SQL insert), never by the
/// prober: an incident is a statement to users, not a derived value.
model StatusIncident {
  id         String    @id @default(cuid())
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  /// Null while the incident is still open.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  title      String
  /// Body copy. A small subset of Markdown: blank-line paragraphs and `- ` bullets.
  bodyMd     String    @map("body_md") @db.Text
  /// Component ids this incident affected, for the attribution line.
  components String[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@map("status_incidents")
}
